APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sesi (27 Sep). Sesi habis sendiri sesudah SESSION_LIFETIME menit tidak
# dipakai; tidak ada lagi cookie "ingat saya" yang dipaksakan. Di produksi
# yang lewat HTTPS, nyalakan SESSION_SECURE_COOKIE supaya cookie sesi tidak
# pernah terkirim lewat sambungan tak terenkripsi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tanggal demo: data contoh disusun untuk 17 Agustus 2026 (sama dengan prototipe).
# Kosongkan untuk pemakaian sungguhan.
SIMTLHP_HARI_INI=2026-08-17
SIMTLHP_DATA_CONTOH=true
# Hanya untuk demo: password akun penanggung jawab yang dibuat dari
# Data master. Kosongkan pada pemasangan sungguhan.
SIMTLHP_PASSWORD_DEMO=

# ==================================================================
# MASUK, SSO eHRM, DIREKTORI PEGAWAI, LOG, KEAMANAN (27 Sep)
# Penjelasan lengkap: config/simtlhp.php dan
# DOKUMEN-PERSIAPAN-MENTOR-SSO-EHRM.md.
#
# Nilai untuk PRODUKSI:
#   APP_ENV=production, APP_DEBUG=false, APP_URL=https://<domain>
#   SESSION_SECURE_COOKIE=true
#   SIMTLHP_HARI_INI= (kosong), SIMTLHP_DATA_CONTOH=false
#   SIMTLHP_PASSWORD_DEMO= (kosong), SIMTLHP_AKUN_DEMO=false
#   SIMTLHP_SSO=oidc + SIMTLHP_OIDC_* dari Pusdatin; sesudah SSO teruji,
#   SIMTLHP_MASUK_PASSWORD=false supaya satu-satunya pintu adalah SSO.
# ==================================================================

# Formulir email + password. false = SSO saja.
SIMTLHP_MASUK_PASSWORD=true
# Salah sekian kali dalam sekian detik (per email + alamat) → dikunci sementara.
SIMTLHP_MASUK_BATAS=5
SIMTLHP_MASUK_JEDA=60
# Daftar akun contoh di halaman Masuk. Kosong = menyala di luar produksi saja.
SIMTLHP_AKUN_DEMO=

# Penyedia SSO: mati | simulasi | oidc. "simulasi" tidak pernah menyala di produksi.
SIMTLHP_SSO=mati
SIMTLHP_SSO_NAMA="SSO PU"
# Nama, jabatan, dan email akun disamakan dengan eHRM tiap kali masuk.
SIMTLHP_SSO_SINKRON=true
# OpenID Connect — SSO PU (login eHRM). Alamat di bawah dibaca 29 Sep dari
# https://sso.pu.go.id/.well-known/openid-configuration; client id + secret,
# redirect URI, dan klaim NIP diminta ke Pusdatin.
SIMTLHP_OIDC_AUTHORIZE=https://sso.pu.go.id/connect/authorize
SIMTLHP_OIDC_TOKEN=https://sso.pu.go.id/connect/token
SIMTLHP_OIDC_USERINFO=https://sso.pu.go.id/connect/userinfo
SIMTLHP_OIDC_LOGOUT=https://sso.pu.go.id/connect/logout
SIMTLHP_OIDC_CLIENT_ID=
SIMTLHP_OIDC_CLIENT_SECRET=
# SSO PU hanya mengumumkan scope openid (dan offline_access).
SIMTLHP_OIDC_SCOPE=openid
# Kosong = ${APP_URL}/masuk/sso/kembali — alamat ini yang didaftarkan ke Pusdatin.
SIMTLHP_OIDC_REDIRECT=
SIMTLHP_OIDC_BATAS_DETIK=10
# Nama klaim di jawaban userinfo (boleh bertitik untuk yang bersarang).
# SSO PU hanya mengumumkan klaim standar (sub, iss, aud, …): tanyakan ke
# Pusdatin klaim mana yang membawa NIP — bisa jadi `sub`.
SIMTLHP_OIDC_KLAIM_NIP=nip
SIMTLHP_OIDC_KLAIM_NAMA=name
SIMTLHP_OIDC_KLAIM_EMAIL=email
SIMTLHP_OIDC_KLAIM_JABATAN=jabatan
SIMTLHP_OIDC_KLAIM_UNIT=unit_kerja

# Direktori pegawai untuk memilih penanggung jawab dan petugas pusat:
# berkas (daftar contoh) | http (layanan eHRM).
SIMTLHP_DIREKTORI=berkas
SIMTLHP_EHRM_URL=
SIMTLHP_EHRM_TOKEN=
SIMTLHP_EHRM_BATAS_DETIK=8
SIMTLHP_EHRM_SIMPAN_MENIT=30
SIMTLHP_EHRM_JALUR_CARI="/pegawai?q={q}"
SIMTLHP_EHRM_JALUR_NIP="/pegawai/{nip}"
SIMTLHP_EHRM_JALUR_UNIT="/unit/{unit}/pegawai"
SIMTLHP_EHRM_WADAH=data
SIMTLHP_EHRM_MEDAN_NIP=nip
SIMTLHP_EHRM_MEDAN_NAMA=nama
SIMTLHP_EHRM_MEDAN_JABATAN=jabatan
SIMTLHP_EHRM_MEDAN_UNIT=kode_unit
SIMTLHP_EHRM_MEDAN_UNIT_NAMA=nama_unit
SIMTLHP_EHRM_MEDAN_EMAIL=email

# Log aktivitas dipangkas sesudah sekian hari (bawaan 5 tahun).
SIMTLHP_LOG_SIMPAN_HARI=1825
# Content-Security-Policy di setiap halaman.
SIMTLHP_CSP=true
# Alamat reverse proxy / penyeimbang beban (pisah koma), atau "*".
SIMTLHP_PROXY_TEPERCAYA=
